PORT=3000
API_PREFIX=/api/v1

# Security and session tokens
JWT_SIGNING_SECRET=replace-with-a-long-random-secret
CRON_SECRET=replace-with-a-long-random-secret
CHALLENGE_TTL_SECONDS=60
SESSION_TTL_SECONDS=900
ENABLE_STRICT_ATTESTATION=false

# Optional remote attestation verifier endpoint (iOS fallback)
ATTESTATION_VERIFIER_URL=

# Android Play Integrity verification
PLAY_INTEGRITY_PACKAGE_NAME=com.isaacdiaz.ravenToPandas
# Preferred in production: set JSON directly in secret manager
PLAY_INTEGRITY_SERVICE_ACCOUNT_JSON=
# Alternative for local development: absolute or project-relative path to JSON file (or directory containing one JSON)
PLAY_INTEGRITY_SERVICE_ACCOUNT_JSON_PATH=
PLAY_INTEGRITY_ALLOWED_DEVICE_VERDICTS=MEETS_DEVICE_INTEGRITY,MEETS_STRONG_INTEGRITY
PLAY_INTEGRITY_REQUIRE_LICENSED=true
PLAY_INTEGRITY_MAX_TOKEN_AGE_MS=120000
PLAY_INTEGRITY_MAX_CLOCK_SKEW_MS=30000

# OpenRouter Management API
OPENROUTER_MANAGEMENT_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MANAGEMENT_KEY=replace-with-management-key
OPENROUTER_KEY_NAME_PREFIX=r2p
OPENROUTER_KEY_LIMIT=0.1
OPENROUTER_KEY_LIMIT_RESET=daily
OPENROUTER_INCLUDE_BYOK_IN_LIMIT=false
OPENROUTER_REQUEST_TIMEOUT_MS=7000
KEY_ROTATE_AFTER_SECONDS=7200
KEY_HARD_EXPIRES_SECONDS=7200
OPENROUTER_EXTRA_CREATE_PAYLOAD=

# Model names served by GET /api/v1/models (public, not secrets).
# Fallbacks match the app defaults (OpenRouterTranslation.ts / OpenRouterGrammarAssist.ts).
OPENROUTER_MODEL=inception/mercury-2.5
OPENROUTER_MODEL_2=inception/mercury-2.5
OPENROUTER_MODEL_3=inception/mercury-2.5
OPENROUTER_MODEL_SEG=inclusionai/ling-3.0-flash-fin
OPENROUTER_MODEL_ASSIST=inception/mercury-2

# Per-minute endpoint limits
RATE_LIMIT_CHALLENGE_PER_MIN=20
RATE_LIMIT_SESSION_PER_MIN=20
RATE_LIMIT_LEASE_PER_MIN=30
RATE_LIMIT_ADMIN_PER_MIN=60

# Storage — pick one (priority: Upstash → Redis/Valkey → SQLite → Memory)
# Vercel prod: Upstash REST
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# VM with Valkey (optional, for parity with prod): uncomment valkey service in docker-compose.yml
REDIS_URL=
VALKEY_PASSWORD=
# VM simple (default): single file, no extra service
DATABASE_URL=sqlite:./data/org.db

# Organization — membership & invites (Parte 02)
# REQUIRED in all envs except `NODE_ENV=test` (fail-fast in dev/prod). Generates admin auth for POST /admin/*.
# Rotation without invalidating memberships: see docs/organizacion/parte-05-manual-usuario.md §7 “Rotación de ORG_ADMIN_SECRET”.
ORG_ADMIN_SECRET=replace-with-a-long-random-secret
ORG_ID=default
ORG_NAME=
ORG_DEFAULT_TTL_DAYS=30
ORG_DEFAULT_BUDGET_CENTS=100
ORG_COST_PER_GENERATION_CENTS=5
ORG_INVITE_TTL_DAYS=7
ORG_MAX_CHARS=2000
